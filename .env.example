# Vela CLI — 环境变量配置
# 复制此文件为 .env 并填入你的 API 密钥

# ===== LLM API 配置 =====
# OpenAI 兼容 API（必填）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o

# ===== 写作默认参数 =====
# 默认每章字数
DEFAULT_WORDS_PER_CHAPTER=3000
# 默认总章数
DEFAULT_TOTAL_CHAPTERS=100

# ===== 项目存储路径 =====
# 默认为当前目录下的 .vela/
VELA_HOME=.vela
